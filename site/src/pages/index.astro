---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Relief from '../components/Relief.astro';
import Signature from '../components/Signature.astro';
import Process from '../components/Process.astro';
import Trust from '../components/Trust.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
---
<Base
  title="Kavēti gada pārskati? Bezmaksas konsultācija | IR& Grāmatvedības birojs"
  description="IR& Grāmatvedības birojs (IR.GRĀMATVEDĪBAS BIROJS SIA): palīdzam sakārtot kavētos gada pārskatus un atbildēt VID. Bezmaksas konsultācija, attālināti visā Latvijā."
>
  <Nav />
  <main>
    <Hero />
    <Relief />
    <Signature />
    <Process />
    <Trust />
    <Faq />
    <LeadForm />
  </main>
  <Footer />
  <StickyCta />
</Base>

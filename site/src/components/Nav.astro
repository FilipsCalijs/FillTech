---
// Placeholder contacts, listed in CLIENT-CHECK.md.
const phoneHref = 'tel:+37120000000';
const whatsappHref = 'https://wa.me/37120000000';
---
<header id="nav" class="nav sticky top-0 z-40 bg-night text-on-night">
  <div class="wrap flex items-center gap-3 md:gap-6">
    <a href="#top" class="logo mr-auto no-underline" aria-label="IR& Grāmatvedības birojs, uz sākumu">
      <span class="logo-tile"><img src="/logo-owl.png" width="29" height="34" alt="" /></span>
      <span class="logo-text">
        <span class="logo-mark">IR&amp;</span>
        <span class="logo-name">Grāmatvedības birojs</span>
      </span>
    </a>

    <a href={phoneHref} class="hidden lg:inline-flex items-center gap-2 text-small no-underline hover:underline">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
      <span>+371 20 000 000</span>
    </a>
    <a href={whatsappHref} class="hidden lg:inline-flex items-center gap-2 text-small no-underline hover:underline">
      WhatsApp
    </a>

    <a href={phoneHref} class="icon-btn lg:hidden" aria-label="Zvanīt +371 20 000 000">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
    </a>
    <a href="#pieteikums" class="btn btn-go nav-cta">Bezmaksas konsultācija</a>
  </div>
</header>

<style>
  .nav {
    padding-block: 1rem;
    border-bottom: 1px solid transparent;
    transition: padding 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }
  .nav[data-compact] {
    padding-block: 0.5rem;
    border-bottom-color: var(--color-night-line);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-on-night);
  }
  .logo-tile {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-action);
    background: var(--color-paper);
  }
  .logo-tile img { width: 29px; height: 34px; }
  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo-mark {
    font-size: 1.375rem;
    font-stretch: 125%;
    font-weight: 850;
    letter-spacing: -0.01em;
  }
  .logo-name {
    margin-top: 0.2rem;
    font-size: 0.8125rem;
    font-weight: 560;
    font-stretch: 100%;
    color: var(--color-on-night-soft);
  }
  @media (max-width: 29.99rem) { .logo-name { display: none; } }
  @media (min-width: 48rem) {
    .logo-text { flex-direction: row; align-items: baseline; gap: 0.45rem; }
    .logo-name { font-size: 1.0625rem; margin: 0; color: var(--color-on-night); }
  }
  .icon-btn {
    flex: none;
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-action);
    box-shadow: inset 0 0 0 1.5px var(--color-night-line);
    color: var(--color-on-night);
  }
  @media (min-width: 64rem) { .icon-btn { display: none; } }
  .nav-cta { flex: none; min-height: 44px; padding: 0.625rem 0.75rem; font-size: 0.875rem; font-stretch: 100%; white-space: nowrap; }
  @media (min-width: 48rem) { .nav-cta { padding: 0.75rem 1.125rem; font-size: 1rem; font-stretch: 108%; } }
</style>

<script>
  const nav = document.getElementById('nav');
  if (nav) {
    const sentinel = document.createElement('div');
    sentinel.style.cssText = 'position:absolute;top:0;height:40px;width:1px;';
    document.body.prepend(sentinel);
    new IntersectionObserver(([entry]) => {
      nav.toggleAttribute('data-compact', !entry.isIntersecting);
    }).observe(sentinel);
  }
</script>

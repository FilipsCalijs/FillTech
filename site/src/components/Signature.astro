---
const captions = [
  'Tagad: čeki, rēķini un vēstules dažādās vietās.',
  'Sašķirojam pa gadiem: 2023, 2024, 2025.',
  'Viss vienā mapē.',
  'Pēc: pārskati iesniegti, viss vienā mapē.',
];
---
<section id="kalns" class="sig bg-graphite text-on-night" aria-labelledby="sig-title">
  <div class="sig-pin">
    <div class="wrap sig-head">
      <h2 id="sig-title" class="t-h2 sig-title">Čeku kalns nav biznesa plāns.</h2>
      <div class="sig-side">
        <ol class="sig-captions" aria-hidden="true">
          {captions.map((c, i) => <li data-step={i}>{c}</li>)}
        </ol>
        <a href="#pieteikums" class="btn btn-go sig-cta">Pieteikt bezmaksas konsultāciju</a>
      </div>
    </div>

    <div class="sig-stage" aria-hidden="true">
      <canvas class="sig-canvas"></canvas>
      <div class="sig-stamp">Iesniegts</div>
    </div>
  </div>

  <div class="wrap sig-fallback">
    <div class="ba-switch" role="group" aria-label="Salīdzināt: tagad un pēc">
      <button type="button" aria-pressed="true" data-ba="tagad">Tagad</button>
      <button type="button" aria-pressed="false" data-ba="pec">Pēc</button>
    </div>
    <figure class="ba-figure" data-show="tagad">
      <div class="ba-frame">
        <img src="/kalns-tagad.webp" width="1200" height="800" loading="lazy" decoding="async"
          alt="Kaudze ar čekiem, rēķiniem un aploksnēm, sajauktiem kopā." data-ba-img="tagad" />
        <img src="/kalns-pec.webp" width="1200" height="800" loading="lazy" decoding="async"
          alt="Tie paši dokumenti sakārtoti vienā aizvērtā mapē ar zīmogu Iesniegts." data-ba-img="pec" />
        <span class="sig-stamp ba-stamp" aria-hidden="true">Iesniegts</span>
      </div>
      <figcaption>
        <span data-ba-cap="tagad">{captions[0]}</span>
        <span data-ba-cap="pec">{captions[3]}</span>
      </figcaption>
    </figure>
    <a href="#pieteikums" class="btn btn-go mt-6">Pieteikt bezmaksas konsultāciju</a>
  </div>
</section>

<style>
  .sig { position: relative; padding-block: clamp(4.5rem, 10vw, 9rem); }
  .sig-title { max-width: 13ch; }
  .sig-captions { display: none; }
  .sig-pin .sig-stage { display: none; }

  /* Fallback: mobile, reduced motion, no WebGL */
  .sig-fallback { margin-top: 2.5rem; }
  .ba-switch {
    display: inline-flex;
    padding: 4px;
    border-radius: var(--radius-action);
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }
  .ba-switch button {
    min-width: 6.5rem;
    min-height: 44px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    font-weight: 700;
    font-stretch: 108%;
    cursor: pointer;
    color: var(--color-on-night-soft);
  }
  .ba-switch button[aria-pressed="true"] { background: var(--color-on-night); color: var(--color-graphite); }
  .ba-figure { margin-top: 1.25rem; }
  .ba-frame { position: relative; border-radius: var(--radius-sheet); overflow: hidden; aspect-ratio: 3 / 2; background: #2f2b25; }
  .ba-frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ba-figure figcaption { margin-top: 0.875rem; color: var(--color-on-night-soft); }
  .ba-figure[data-show="tagad"] [data-ba-img="pec"],
  .ba-figure[data-show="tagad"] [data-ba-cap="pec"],
  .ba-figure[data-show="tagad"] .ba-stamp,
  .ba-figure[data-show="pec"] [data-ba-img="tagad"],
  .ba-figure[data-show="pec"] [data-ba-cap="tagad"] { display: none; }

  .sig-stamp {
    position: absolute;
    left: 54%;
    top: 47%;
    padding: 0.35em 0.7em 0.4em;
    border: 4px solid var(--color-go);
    border-radius: 6px;
    color: var(--color-go);
    font-size: clamp(1.75rem, 1rem + 3vw, 3.75rem);
    font-stretch: 125%;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    transform: translate(-50%, -50%) rotate(-8deg);
    pointer-events: none;
  }
  .ba-stamp { top: 52%; font-size: clamp(1.5rem, 0.8rem + 3vw, 3rem); }

  /* 3D mode (desktop, motion allowed, WebGL ok) */
  .sig.is-3d { padding-block: 0; }
  .sig.is-3d .sig-fallback { display: none; }
  .sig.is-3d .sig-pin {
    height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr;
    padding-top: clamp(4rem, 8vh, 6rem);
  }
  .sig.is-3d .sig-stage { display: block; position: relative; min-height: 0; }
  .sig.is-3d .sig-canvas { width: 100%; height: 100%; }
  .sig.is-3d .sig-head { display: grid; grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: end; }
  .sig-side { min-height: 7.5rem; display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start; }
  .sig.is-3d .sig-captions { display: grid; }
  .sig-side .sig-cta { display: none; }
  .sig.is-3d .sig-side .sig-cta {
    display: inline-flex;
    margin-top: 1.25rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 260ms var(--ease-out), transform 260ms var(--ease-out), visibility 0s 260ms;
  }
  .sig.is-3d .sig-side .sig-cta.is-on { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .sig-captions li {
    grid-area: 1 / 1;
    font-size: var(--text-lead);
    line-height: 1.45;
    color: var(--color-on-night);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 260ms var(--ease-out), transform 260ms var(--ease-out);
  }
  .sig-captions li.is-on { opacity: 1; transform: none; }
  .sig.is-3d .sig-stage .sig-stamp { opacity: 0; }
</style>

<script>
  const section = document.getElementById('kalns')!;
  const canvas = section.querySelector<HTMLCanvasElement>('.sig-canvas')!;
  const stamp = section.querySelector<HTMLElement>('.sig-stage .sig-stamp')!;
  const captions = section.querySelectorAll<HTMLElement>('.sig-captions li');

  // Tagad / Pēc fallback switch
  const figure = section.querySelector<HTMLElement>('.ba-figure')!;
  section.querySelectorAll<HTMLButtonElement>('[data-ba]').forEach((btn, _, all) => {
    btn.addEventListener('click', () => {
      all.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      figure.dataset.show = btn.dataset.ba!;
    });
  });

  const wantsMotion = window.matchMedia('(prefers-reduced-motion: no-preference)');
  const wide = window.matchMedia('(min-width: 64rem)');
  const forced = new URLSearchParams(location.search).get('kalns');

  function webglOk() {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  const cta = section.querySelector<HTMLElement>('.sig-side .sig-cta')!;

  // Caption per act: 0-.25 pile, .25-.55 year stacks, .55-.8 folder, .8+ stamp.
  function setCaption(p: number) {
    const idx = p < 0.25 ? 0 : p < 0.55 ? 1 : p < 0.82 ? 2 : 3;
    captions.forEach((c, i) => c.classList.toggle('is-on', i === idx));
    cta.classList.toggle('is-on', idx === 3);
  }

  // The stamp drops in from above and lands at 1:1.
  function setStamp(p: number) {
    const t = Math.min(1, Math.max(0, (p - 0.82) / 0.07));
    const e = 1 - Math.pow(1 - t, 3);
    stamp.style.opacity = String(Math.min(1, t * 2));
    stamp.style.transform = `translate(-50%, calc(-50% - ${(1 - e) * 120}px)) rotate(-8deg) scale(${1.5 - 0.5 * e})`;
  }

  async function start3d() {
    const [{ createKalnsScene }, { gsap }, { ScrollTrigger }] = await Promise.all([
      import('../scripts/kalns-scene'),
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]);
    await document.fonts.ready;
    const scene = createKalnsScene(canvas);

    // Static capture mode for the Tagad/Pēc images: ?kalns=0 or ?kalns=1
    if (forced !== null) {
      const p = Number(forced);
      scene.setProgress(p);
      scene.renderNow();
      setCaption(p);
      setStamp(p);
      return;
    }

    gsap.registerPlugin(ScrollTrigger);
    setCaption(0);
    setStamp(0);
    // Scrub a proxy object; the scene and captions read it on every update.
    const state = { progress: 0 };
    gsap.to(state, {
      progress: 1,
      ease: 'none',
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: '+=250%',
        pin: section.querySelector('.sig-pin'),
        scrub: 0.6,
      },
      onUpdate() {
        scene.setProgress(state.progress);
        setCaption(state.progress);
        setStamp(state.progress);
      },
    });
  }

  if ((forced !== null || (wantsMotion.matches && wide.matches)) && webglOk()) {
    // Switch layout right away (no shift later), load the scene lazily.
    section.classList.add('is-3d');
    // Load the scene only when the visitor approaches the section.
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        start3d();
      }
    }, { rootMargin: '100% 0px' });
    io.observe(section);
  }
</script>

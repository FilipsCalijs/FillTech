<div class="sticky-cta" id="sticky-cta" hidden>
  <a href="#pieteikums" class="btn btn-go">Pieteikt bezmaksas konsultāciju</a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    padding: 0.75rem 16px calc(0.75rem + env(safe-area-inset-bottom));
    background: var(--color-night);
    border-top: 1px solid var(--color-night-line);
    transform: translateY(0);
    transition: transform 220ms var(--ease-out);
  }
  .sticky-cta .btn { width: 100%; }
  .sticky-cta[data-off] { transform: translateY(110%); }
  @media (min-width: 64rem) { .sticky-cta { display: none; } }
</style>

<script>
  // Mobile only: shows after the hero, hides while the form is on screen.
  const bar = document.getElementById('sticky-cta')!;
  const hero = document.getElementById('top');
  const form = document.getElementById('pieteikums');
  let heroVisible = true;
  let formVisible = false;
  const update = () => bar.toggleAttribute('data-off', heroVisible || formVisible);
  bar.hidden = false;
  bar.setAttribute('data-off', '');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.target === hero) heroVisible = e.isIntersecting;
      if (e.target === form) formVisible = e.isIntersecting;
    }
    update();
  });
  if (hero) io.observe(hero);
  if (form) io.observe(form);
</script>

---
// Only facts from PRODUCT.md → Evidence on Hand.
const facts = [
  { big: '7 gadi', small: 'pieredze grāmatvedībā' },
  { big: 'Visa Latvija', small: 'strādājam attālināti, uz biroju nav jābrauc' },
  { big: 'Tiešsaistē', small: 'dokumentus vari nodot elektroniski' },
  { big: 'VID', small: 'palīdzam saziņā ar VID' },
];
---
<section class="trust bg-night text-on-night section" aria-labelledby="trust-title">
  <div class="wrap trust-grid">
    <div>
      <h2 id="trust-title" class="t-h2 trust-title">VID vēstule nav labākais atgādinājums.</h2>
      <p class="t-lead measure mt-5 text-on-night-soft">
        IR&amp; Grāmatvedības birojs palīdz SIA, kas atlikušas gada pārskatus. Sāc ar bezmaksas konsultāciju.
      </p>

      <dl class="facts">
        {facts.map((f) => (
          <div class="fact">
            <dt>{f.big}</dt>
            <dd>{f.small}</dd>
          </div>
        ))}
      </dl>
    </div>

    <figure class="person">
      <div class="person-photo" aria-hidden="true">
        <span class="monogram">IR&amp;</span>
      </div>
      <figcaption>
        <span class="person-name">Grāmatvedības birojs</span>
        <span class="person-role">7 gadu pieredze</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .trust-grid { display: grid; gap: 3rem; }
  @media (min-width: 64rem) { .trust-grid { grid-template-columns: 1.4fr 1fr; gap: 5rem; align-items: start; } }
  .trust-title { max-width: 13ch; }
  .facts { margin-top: clamp(2.5rem, 5vw, 3.5rem); border-top: 1px solid var(--color-night-line); }
  .fact {
    display: grid;
    gap: 0.25rem;
    padding-block: 1.125rem;
    border-bottom: 1px solid var(--color-night-line);
  }
  @media (min-width: 48rem) {
    .fact { grid-template-columns: 15rem 1fr; align-items: baseline; gap: 1.5rem; }
  }
  .fact dt {
    font-size: clamp(1.625rem, 1.2rem + 1.4vw, 2.25rem);
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  .fact dd { color: var(--color-on-night-soft); font-size: var(--text-lead); }
  .person { max-width: 18rem; }
  @media (min-width: 64rem) { .person { max-width: none; } }
  .person-photo {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-sheet);
    background: var(--color-paper);
    display: grid;
    place-items: center;
  }
  .monogram {
    font-size: clamp(4rem, 3rem + 4vw, 7rem);
    font-stretch: 125%;
    font-weight: 850;
    letter-spacing: -0.02em;
    color: var(--color-night);
  }
  .person figcaption { margin-top: 1rem; display: grid; gap: 0.25rem; }
  .person-name { font-weight: 700; font-stretch: 108%; }
  .person-role { color: var(--color-on-night-soft); font-size: var(--text-small); }
</style>

---
import { SITUATIONS } from '../scripts/situations';
import { TRACKING_PARAMS } from '../scripts/lead-store';

const TOTAL = 6;
const years = ['2022 un agrāk', '2023', '2024', '2025', 'Nezinu precīzi'];
---
<section id="pieteikums" class="lead bg-night text-on-night section" aria-labelledby="lead-title">
  <div class="wrap lead-grid">
    <div class="lead-intro">
      <h2 id="lead-title" class="t-h2">Piesakies bezmaksas konsultācijai</h2>
      <p class="t-lead mt-5 text-on-night-soft measure">
        Seši īsi jautājumi, lai uz sarunu nāktu sagatavoti. Konsultācija ir bez maksas.
      </p>
      <p class="mt-4 text-on-night-soft measure">
        Pēc pieteikuma sazināsimies darba dienas laikā.
      </p>
    </div>

    <div class="lead-sheet on-light">
      <form id="lead-form" name="konsultacija" method="POST" action="/" data-netlify="true" netlify-honeypot="bot-field" novalidate>
        <input type="hidden" name="form-name" value="konsultacija" />
        <input type="hidden" name="lead_type" value="kavetie-gada-parskati" />
        <input type="hidden" name="score" value="" />
        <input type="hidden" name="priority" value="" />
        {TRACKING_PARAMS.map((p) => <input type="hidden" name={p} value="" />)}
        <p class="hp" aria-hidden="true"><label>Neaizpildīt <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

        <div class="progress" aria-live="polite">
          <p class="progress-label">Solis <span data-step-now>1</span> no {TOTAL}</p>
          <div class="progress-bar"><i data-bar></i></div>
        </div>

        <fieldset class="step" data-step="1">
          <legend class="step-q">Kas notika?</legend>
          <p class="step-hint">Vari atzīmēt vairākus.</p>
          <div class="opts">
            {SITUATIONS.map((s) => (
              <label class="opt"><input type="checkbox" name="situations" value={s.key} /><span>{s.label}</span></label>
            ))}
            <label class="opt"><input type="checkbox" name="situations" value="cits" /><span>Cits</span></label>
          </div>
          <p class="err" data-err="situations"></p>
        </fieldset>

        <fieldset class="step" data-step="2" hidden>
          <legend class="step-q">Par kuriem gadiem?</legend>
          <p class="step-hint">Vari atzīmēt vairākus.</p>
          <div class="opts opts-row">
            {years.map((y) => (
              <label class="opt"><input type="checkbox" name="years" value={y} /><span>{y}</span></label>
            ))}
          </div>
          <p class="err" data-err="years"></p>
        </fieldset>

        <fieldset class="step" data-step="3" hidden>
          <legend class="step-q">Par uzņēmumu</legend>
          <div class="group">
            <p class="group-label" id="g-form">Uzņēmuma forma</p>
            <div class="seg" role="radiogroup" aria-labelledby="g-form">
              {['SIA', 'IK', 'Cits'].map((v) => <label class="seg-opt"><input type="radio" name="company_form" value={v} /><span>{v}</span></label>)}
            </div>
          </div>
          <div class="group">
            <p class="group-label" id="g-emp">Darbinieku skaits</p>
            <div class="seg" role="radiogroup" aria-labelledby="g-emp">
              {['0', '1-5', '6+'].map((v) => <label class="seg-opt"><input type="radio" name="employees" value={v} /><span>{v}</span></label>)}
            </div>
          </div>
          <div class="group">
            <p class="group-label" id="g-vat">PVN maksātājs</p>
            <div class="seg" role="radiogroup" aria-labelledby="g-vat">
              {['Jā', 'Nē', 'Nezinu'].map((v) => <label class="seg-opt"><input type="radio" name="vat" value={v} /><span>{v}</span></label>)}
            </div>
          </div>
          <p class="soft-note" data-soft-note hidden>Pieteikumu pieņemam. Konsultācijā noskaidrosim, vai varam palīdzēt tieši tavā gadījumā.</p>
          <p class="err" data-err="company"></p>
        </fieldset>

        <fieldset class="step" data-step="4" hidden>
          <legend class="step-q">Cik steidzami?</legend>
          <div class="opts">
            <label class="opt"><input type="radio" name="urgency" value="lt2w" /><span>VID termiņš ir tuvāk par 2 nedēļām</span></label>
            <label class="opt"><input type="radio" name="urgency" value="month" /><span>Gribu sākt šomēnes</span></label>
            <label class="opt"><input type="radio" name="urgency" value="later" /><span>Nav steidzami</span></label>
          </div>
          <p class="err" data-err="urgency"></p>
        </fieldset>

        <fieldset class="step" data-step="5" hidden>
          <legend class="step-q">Konsultācija ir bez maksas. Pēc tās sagatavosim piedāvājumu sakārtošanai. Vai tas Tev der?</legend>
          <div class="opts">
            <label class="opt"><input type="radio" name="budget" value="yes" /><span>Jā</span></label>
            <label class="opt"><input type="radio" name="budget" value="price-first" /><span>Vispirms gribu uzzināt cenu</span></label>
            <label class="opt"><input type="radio" name="budget" value="no" /><span>Nē</span></label>
          </div>
          <p class="err" data-err="budget"></p>
        </fieldset>

        <fieldset class="step" data-step="6" hidden>
          <legend class="step-q">Kā ar tevi sazināties?</legend>
          <div class="fields">
            <div class="field">
              <label for="f-name">Vārds</label>
              <input id="f-name" name="name" type="text" autocomplete="given-name" required />
              <p class="err" data-err="name"></p>
            </div>
            <div class="field">
              <label for="f-phone">Tālrunis</label>
              <div class="phone">
                <span aria-hidden="true">+371</span>
                <input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel-national" aria-describedby="phone-hint" />
              </div>
              <p class="field-hint" id="phone-hint">Tālrunis vai e-pasts, pietiek ar vienu.</p>
              <p class="err" data-err="phone"></p>
            </div>
            <div class="field">
              <label for="f-email">E-pasts</label>
              <input id="f-email" name="email" type="email" autocomplete="email" />
              <p class="err" data-err="email"></p>
            </div>
            <div class="field">
              <label for="f-company">Uzņēmuma nosaukums <span class="optional">(nav obligāts)</span></label>
              <input id="f-company" name="company" type="text" autocomplete="organization" />
            </div>
            <div class="field">
              <p class="group-label" id="g-ch">Kā ērtāk sazināties?</p>
              <div class="seg" role="radiogroup" aria-labelledby="g-ch">
                {['Zvans', 'WhatsApp', 'E-pasts'].map((v, i) => <label class="seg-opt"><input type="radio" name="channel" value={v} checked={i === 0} /><span>{v}</span></label>)}
              </div>
            </div>
            <div class="field">
              <label for="f-time">Ērtākais laiks <span class="optional">(nav obligāts)</span></label>
              <input id="f-time" name="time" type="text" placeholder="piem., darba dienās pēc 16:00" />
            </div>
            <label class="consent">
              <input type="checkbox" name="consent" value="yes" required />
              <span>Piekrītu, ka mani dati tiek izmantoti, lai sazinātos par konsultāciju. <a href="/privatuma-politika">Privātuma politika</a></span>
            </label>
            <p class="err" data-err="consent"></p>
          </div>
        </fieldset>

        <div class="nav-row">
          <button type="button" class="btn btn-back" data-back hidden>Atpakaļ</button>
          <button type="button" class="btn btn-done" data-next>Tālāk</button>
          <button type="submit" class="btn btn-done" data-submit hidden>Pieteikt konsultāciju</button>
        </div>
        <p class="err send-err" data-err="send"></p>
      </form>

      <div class="thanks" id="lead-thanks" hidden tabindex="-1">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
        <h3 class="t-h3">Paldies! Sazināsimies darba dienas laikā.</h3>
        <p class="text-ink-soft">Līdz tam neko kārtot nevajag.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .lead-grid { display: grid; gap: 2.5rem; }
  @media (min-width: 64rem) { .lead-grid { grid-template-columns: 1fr 1.15fr; gap: 5rem; align-items: start; } }
  .lead-intro h2 { max-width: 12ch; }
  .lead-sheet {
    background: var(--color-sheet);
    color: var(--color-ink);
    border-radius: var(--radius-sheet);
    padding: 1.5rem 1.25rem;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.55);
  }
  @media (min-width: 48rem) { .lead-sheet { padding: 2.25rem 2.25rem 2rem; } }
  .hp { position: absolute; left: -9999px; }

  .progress-label { font-size: var(--text-small); color: var(--color-ink-soft); font-weight: 560; }
  .progress-bar { margin-top: 0.5rem; height: 4px; background: var(--color-line); border-radius: 2px; overflow: hidden; }
  .progress-bar i { display: block; height: 100%; width: 16.66%; background: var(--color-done); transition: width 260ms var(--ease-out); }

  .step { margin-top: 1.75rem; }
  .step-q { font-size: 1.5rem; line-height: 1.2; font-weight: 750; font-stretch: 112%; letter-spacing: -0.01em; }
  .step-hint { margin-top: 0.375rem; color: var(--color-ink-soft); font-size: var(--text-small); }
  .opts { margin-top: 1rem; display: grid; gap: 0.5rem; }
  .opts-row { grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); }
  .opt {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.625rem 0.875rem;
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius-field);
    cursor: pointer;
    font-weight: 540;
  }
  .opt:hover { border-color: var(--color-ink-soft); }
  .opt:has(input:checked) { border-color: var(--color-done); background: var(--color-done-wash); }
  .opt input, .consent input { width: 1.25rem; height: 1.25rem; margin: 0; flex: none; accent-color: var(--color-done); }

  .group { margin-top: 1.25rem; }
  .group-label { font-weight: 650; margin-bottom: 0.5rem; }
  .seg { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; border: 1.5px solid var(--color-line); border-radius: var(--radius-field); overflow: hidden; }
  .seg-opt { position: relative; }
  .seg-opt + .seg-opt { border-left: 1.5px solid var(--color-line); }
  .seg-opt input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .seg-opt span { display: grid; place-items: center; min-height: 3rem; padding: 0.5rem; font-weight: 600; }
  .seg-opt input:checked + span { background: var(--color-done); color: #fff; }
  .seg-opt input:focus-visible + span { outline: 3px solid var(--color-done); outline-offset: -3px; }
  .soft-note { margin-top: 1rem; padding: 0.75rem 1rem; background: var(--color-paper); border-radius: var(--radius-field); font-size: var(--text-small); }

  .fields { margin-top: 1rem; display: grid; gap: 1rem; }
  .field label, .field .group-label { display: block; font-weight: 650; margin-bottom: 0.375rem; }
  .optional { font-weight: 450; color: var(--color-ink-soft); }
  .field input[type="text"], .field input[type="email"], .phone {
    width: 100%;
    min-height: 3rem;
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius-field);
    background: #fff;
    box-sizing: border-box;
  }
  .field input[type="text"], .field input[type="email"] { padding: 0.625rem 0.875rem; }
  .field input:focus-visible, .phone:focus-within { outline: none; border-color: var(--color-done); box-shadow: 0 0 0 3px var(--color-done-wash); }
  .phone { display: flex; align-items: center; }
  .phone span { padding-left: 0.875rem; color: var(--color-ink-soft); font-weight: 600; }
  .phone input { flex: 1; min-width: 0; border: 0; padding: 0.625rem 0.875rem 0.625rem 0.5rem; background: transparent; outline: none; }
  .field-hint { margin-top: 0.25rem; font-size: 0.875rem; color: var(--color-ink-soft); }
  .field [aria-invalid="true"], .phone:has([aria-invalid="true"]) { border-color: var(--color-due); }
  .consent { display: flex; gap: 0.75rem; align-items: flex-start; font-size: var(--text-small); cursor: pointer; }
  .consent input { margin-top: 0.15rem; }

  .err { color: var(--color-due); font-size: var(--text-small); font-weight: 600; margin-top: 0.5rem; }
  .err:empty { display: none; }

  .nav-row { display: flex; gap: 0.75rem; margin-top: 2rem; }
  .nav-row [data-next], .nav-row [data-submit] { flex: 1; }
  .btn-back { background: transparent; color: var(--color-ink); box-shadow: inset 0 0 0 1.5px var(--color-line); }
  .btn-back:hover { box-shadow: inset 0 0 0 1.5px var(--color-ink-soft); }
  .btn[disabled] { opacity: 0.6; cursor: progress; }

  .thanks { display: grid; gap: 0.75rem; padding-block: 1rem; outline: none; }
  .thanks svg { color: var(--color-done); }
</style>

<script>
  import { readLead, writeLead, clearLead, readTracking } from '../scripts/lead-store';

  const WEBHOOK = import.meta.env.PUBLIC_LEAD_WEBHOOK_URL as string | undefined;
  const TOTAL = 6;

  const form = document.getElementById('lead-form') as HTMLFormElement;
  const thanks = document.getElementById('lead-thanks')!;
  const steps = Array.from(form.querySelectorAll<HTMLFieldSetElement>('.step'));
  const btnBack = form.querySelector<HTMLButtonElement>('[data-back]')!;
  const btnNext = form.querySelector<HTMLButtonElement>('[data-next]')!;
  const btnSubmit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const stepNow = form.querySelector('[data-step-now]')!;
  const bar = form.querySelector<HTMLElement>('[data-bar]')!;
  const softNote = form.querySelector<HTMLElement>('[data-soft-note]')!;
  let current = 1;

  const track = (event: string, data: Record<string, unknown> = {}) => {
    const w = window as unknown as { dataLayer?: unknown[] };
    (w.dataLayer = w.dataLayer || []).push({ event, ...data });
  };

  const checked = (name: string) =>
    Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map((i) => i.value);
  const val = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | null)?.value.trim() ?? '';

  function setErr(key: string, msg: string) {
    const el = form.querySelector<HTMLElement>(`[data-err="${key}"]`);
    if (el) el.textContent = msg;
  }
  function clearErrs(scope: Element) {
    scope.querySelectorAll<HTMLElement>('.err').forEach((e) => (e.textContent = ''));
    scope.querySelectorAll('[aria-invalid]').forEach((e) => e.removeAttribute('aria-invalid'));
  }
  function invalid(name: string, key: string, msg: string) {
    const input = form.elements.namedItem(name) as HTMLInputElement | null;
    input?.setAttribute('aria-invalid', 'true');
    setErr(key, msg);
    return input;
  }

  function validate(step: number): boolean {
    const fs = steps[step - 1];
    clearErrs(fs);
    let first: HTMLElement | null = null;
    const need = (ok: boolean, key: string, msg: string, focusSel: string) => {
      if (ok) return;
      setErr(key, msg);
      first ??= fs.querySelector<HTMLElement>(focusSel);
    };
    if (step === 1) need(checked('situations').length > 0, 'situations', 'Izvēlies vismaz vienu variantu.', 'input');
    if (step === 2) need(checked('years').length > 0, 'years', 'Izvēlies vismaz vienu gadu.', 'input');
    if (step === 3) need(['company_form', 'employees', 'vat'].every((n) => checked(n).length), 'company', 'Atbildi uz visiem trim jautājumiem.', 'input');
    if (step === 4) need(checked('urgency').length > 0, 'urgency', 'Izvēlies vienu variantu.', 'input');
    if (step === 5) need(checked('budget').length > 0, 'budget', 'Izvēlies vienu variantu.', 'input');
    if (step === 6) {
      const phone = val('phone').replace(/[\s-]/g, '').replace(/^\+?371/, '');
      const email = val('email');
      const channel = checked('channel')[0];
      if (!val('name')) first ??= invalid('name', 'name', 'Ieraksti vārdu.');
      if (!phone && !email) {
        first ??= invalid('phone', 'phone', 'Ieraksti tālruni vai e-pastu.');
      }
      if (phone && !/^\d{8}$/.test(phone)) first ??= invalid('phone', 'phone', 'Tālrunim jābūt 8 cipariem, piem., 20 000 000.');
      if ((channel === 'Zvans' || channel === 'WhatsApp') && !phone && email) {
        first ??= invalid('phone', 'phone', `Lai sazinātos ar ${channel === 'Zvans' ? 'zvanu' : 'WhatsApp'}, ieraksti tālruni.`);
      }
      if (channel === 'E-pasts' && !email) first ??= invalid('email', 'email', 'Lai sazinātos ar e-pastu, ieraksti e-pastu.');
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) first ??= invalid('email', 'email', 'E-pasta adrese izskatās nepareiza.');
      need(checked('consent').length > 0, 'consent', 'Lai nosūtītu pieteikumu, jāpiekrīt datu izmantošanai.', 'input[name="consent"]');
    }
    if (first) (first as HTMLElement).focus();
    return !first;
  }

  function show(step: number, focus = true) {
    current = step;
    steps.forEach((fs, i) => (fs.hidden = i !== step - 1));
    btnBack.hidden = step === 1;
    btnNext.hidden = step === TOTAL;
    btnSubmit.hidden = step !== TOTAL;
    stepNow.textContent = String(step);
    bar.style.width = `${(step / TOTAL) * 100}%`;
    writeLead({ step });
    if (focus) steps[step - 1].querySelector<HTMLElement>('legend')?.setAttribute('tabindex', '-1');
    if (focus) steps[step - 1].querySelector<HTMLElement>('legend')?.focus({ preventScroll: true });
    track('lead_step', { step });
  }

  function saveDraft() {
    writeLead({
      situations: checked('situations'),
      years: checked('years'),
      form: checked('company_form')[0],
      employees: checked('employees')[0],
      vat: checked('vat')[0],
      urgency: checked('urgency')[0],
      budget: checked('budget')[0],
      name: val('name'),
      phone: val('phone'),
      email: val('email'),
      company: val('company'),
      channel: checked('channel')[0],
      time: val('time'),
    });
  }

  function restore() {
    const d = readLead();
    const setChecks = (name: string, values?: string[] | string) => {
      if (!values) return;
      const list = Array.isArray(values) ? values : [values];
      form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`).forEach((i) => (i.checked = list.includes(i.value)));
    };
    setChecks('situations', d.situations);
    setChecks('years', d.years);
    setChecks('company_form', d.form);
    setChecks('employees', d.employees);
    setChecks('vat', d.vat);
    setChecks('urgency', d.urgency);
    setChecks('budget', d.budget);
    setChecks('channel', d.channel);
    for (const [k, v] of Object.entries({ name: d.name, phone: d.phone, email: d.email, company: d.company, time: d.time })) {
      const el = form.elements.namedItem(k) as HTMLInputElement | null;
      if (el && v) el.value = v;
    }
    show(Math.min(Math.max(d.step ?? 1, 1), TOTAL), false);
  }

  function updateSoftNote() {
    const f = checked('company_form')[0];
    const e = checked('employees')[0];
    softNote.hidden = !((f && f !== 'SIA') || e === '6+');
  }

  function score(): { score: number; priority: string } {
    let s = 0;
    const sit = checked('situations');
    if (sit.includes('vid')) s += 2;
    if (sit.length) s += 1;
    s += Math.min(checked('years').length, 3);
    s += ({ lt2w: 3, month: 2, later: 0 } as Record<string, number>)[checked('urgency')[0]] ?? 0;
    s += ({ yes: 3, 'price-first': 1, no: -3 } as Record<string, number>)[checked('budget')[0]] ?? 0;
    return { score: s, priority: checked('budget')[0] === 'no' ? 'cold' : s >= 7 ? 'hot' : 'warm' };
  }

  // Hero situation choice pre-fills step 1.
  document.addEventListener('irg:situation', (e) => {
    const key = (e as CustomEvent<string>).detail;
    form.querySelectorAll<HTMLInputElement>('input[name="situations"]').forEach((i) => {
      if (i.value === key) i.checked = true;
    });
    saveDraft();
  });

  form.addEventListener('change', () => { saveDraft(); updateSoftNote(); });
  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.getAttribute('aria-invalid')) { t.removeAttribute('aria-invalid'); }
  });
  btnNext.addEventListener('click', () => { if (validate(current)) show(current + 1); });
  btnBack.addEventListener('click', () => show(current - 1));
  // Enter in a text field moves forward instead of submitting early.
  form.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && current < TOTAL && (e.target as HTMLElement).tagName === 'INPUT') {
      e.preventDefault();
      btnNext.click();
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate(TOTAL)) return;
    setErr('send', '');

    const tracking = readTracking();
    for (const [k, v] of Object.entries(tracking)) {
      const el = form.elements.namedItem(k) as HTMLInputElement | null;
      if (el) el.value = v;
    }
    const sc = score();
    (form.elements.namedItem('score') as HTMLInputElement).value = String(sc.score);
    (form.elements.namedItem('priority') as HTMLInputElement).value = sc.priority;

    const fd = new FormData(form);
    const payload: Record<string, string> = {};
    for (const [k, v] of fd.entries()) {
      if (k === 'bot-field') continue;
      payload[k] = payload[k] ? `${payload[k]}, ${v}` : String(v);
    }
    const phone = val('phone').replace(/[\s-]/g, '').replace(/^\+?371/, '');
    if (phone) payload.phone = `+371${phone}`;

    btnSubmit.disabled = true;
    btnSubmit.textContent = 'Sūtām…';

    let ok = false;
    if (WEBHOOK) {
      try {
        const r = await fetch(WEBHOOK, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        ok = r.ok;
      } catch { ok = false; }
    }
    if (!ok) {
      try {
        const r = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(payload).toString(),
        });
        ok = r.ok;
      } catch { ok = false; }
    }
    if (!ok && !WEBHOOK) {
      // Demo mode: no webhook configured and no Netlify Forms on this host.
      console.warn('[lead] Demo mode: PUBLIC_LEAD_WEBHOOK_URL is not set, lead not sent.', payload);
      ok = true;
    }

    btnSubmit.disabled = false;
    btnSubmit.textContent = 'Pieteikt konsultāciju';
    if (!ok) {
      setErr('send', 'Neizdevās nosūtīt. Mēģini vēlreiz vai zvani mums.');
      return;
    }
    track('lead_submit', { priority: sc.priority });
    const w = window as unknown as { fbq?: (...a: unknown[]) => void };
    w.fbq?.('track', 'Lead');
    clearLead();
    form.hidden = true;
    thanks.hidden = false;
    thanks.focus();
  });

  readTracking();
  restore();
  updateSoftNote();
</script>

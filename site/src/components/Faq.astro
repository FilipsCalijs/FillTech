---
interface Item { q: string; a: string; todo?: string }
const items: Item[] = [
  {
    q: 'Man ir kauns, ka 3 gadi nav kārtoti.',
    a: 'Tā ir bieža situācija. Bez pārmetumiem sāksim ar sarunu.',
  },
  {
    q: 'Ja dokumentu trūkst?',
    a: 'Sāksim ar to, kas ir. Trūkstošo palīdzēsim atjaunot.',
  },
  {
    q: 'Vai jābrauc uz biroju?',
    a: 'Nē. Strādājam attālināti visā Latvijā, dokumentus nodod tiešsaistē.',
  },
  {
    q: 'Vai varat sazināties ar VID manā vietā?',
    a: 'Jā. Ar Tavu pilnvaru EDS varam sazināties ar VID Tavā vietā.',
  },
  {
    q: 'Cik tas maksās?',
    a: 'Cenu nosaucam pēc bezmaksas konsultācijas, kad redzam darba apjomu.',
  },
];
---
<section class="faq bg-paper text-ink on-light section" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <h2 id="faq-title" class="t-h2 faq-title">Jautājumi, ko kautrējas uzdot</h2>
    <div class="faq-list">
      {items.map((it) => (
        <details class="faq-item">
          <summary>
            <span>{it.q}</span>
            <svg class="chev" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </summary>
          <p class="faq-a">
            {it.a}{it.a && it.todo && ' '}{it.todo && <span class="todo">{it.todo}</span>}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid { display: grid; gap: 2.5rem; }
  @media (min-width: 64rem) { .faq-grid { grid-template-columns: 1fr 1.3fr; gap: 5rem; align-items: start; } }
  .faq-title { max-width: 11ch; }
  .faq-list { border-top: 1px solid var(--color-line); }
  .faq-item { border-bottom: 1px solid var(--color-line); }
  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 4rem;
    padding-block: 1rem;
    cursor: pointer;
    list-style: none;
    font-size: 1.1875rem;
    font-weight: 650;
    font-stretch: 106%;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .chev { flex: none; transition: transform 200ms var(--ease-out); color: var(--color-ink-soft); }
  .faq-item[open] .chev { transform: rotate(180deg); }
  .faq-a { padding: 0 2.5rem 1.5rem 0; color: var(--color-ink-soft); max-width: 60ch; }
</style>
